---
import Layout from "@/layouts/Layout.astro";

import Experience from "@/components/sections/Experience.astro";
import About from "@/components/sections/About.astro";
import Skills from "@/components/sections/Skills.astro";
import Education from "@/components/sections/Education.astro";
import Projects from "@/components/sections/Projects.astro";
import Hero from "@/components/sections/Hero.astro";
import Languages from "@/components/sections/Languages.astro";
import Print from "@/components/sections/Print.astro";

import cvEs from "@cv";
import cvEn from "@cv_eng";

const i18n = {
	es: {
		hero: {
			email: "Correo",
			phone: "Telefono",
			phone2: "Telefono 2",
			linkedin: "Linkedin",
			mailTitle: "Enviar correo electrónico a",
			phoneTitle: "Llamar a",
			socialTitle: "Visitar el perfil de",
		},
		aboutTitle: "🧠 Acerca de..",
		experienceTitle: "👷🏽‍♂️ Experiencia laboral",
		educationTitle: "🎓 Educación",
		languagesTitle: "🗣️ Idiomas",
		projectsTitle: "🚀 Proyectos",
		skillsTitle: "💻 Habilidades",
	},
	en: {
		hero: {
			email: "Email",
			phone: "Phone",
			phone2: "Phone 2",
			linkedin: "Linkedin",
			mailTitle: "Send E-mail to",
			phoneTitle: "Call to",
			socialTitle: "Take a look at",
		},
		aboutTitle: "🧠 About..",
		experienceTitle: "👷🏽‍♂️ Work experience",
		educationTitle: "🎓 Education",
		languagesTitle: "🗣️ Languages",
		projectsTitle: "🚀 Projects",
		skillsTitle: "💻 Skills",
	},
};
---

<script>
	class LangButton extends HTMLElement {
		connectedCallback() {
			const langButtons = this.querySelectorAll("button");
			const elementoEs = this.querySelector(
				"#elemento-es",
			) as HTMLElement;
			const elementoEng = this.querySelector(
				"#elemento-eng",
			) as HTMLElement;

			const updateDisplay = (lang: string) => {
				this.dataset.languaje = lang;
				if (lang === "es") {
					elementoEs.style.display = "block";
					elementoEng.style.display = "none";
				} else {
					elementoEng.style.display = "block";
					elementoEs.style.display = "none";
				}
			};

			// Initialize from localStorage or default to 'es'
			const savedLang = localStorage.getItem("preferred-lang") || "es";
			updateDisplay(savedLang);

			langButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					const currentlang = this.dataset.languaje;
					const newLang = currentlang === "es" ? "eng" : "es";
					localStorage.setItem("preferred-lang", newLang);
					updateDisplay(newLang);
				});
			});
		}
	}
	customElements.define("lang-button", LangButton);
</script>

<Layout title="Portafolio Cristian Gaviria" />
<main>
	<lang-button data-languaje="es">
		<div id="elemento-es" style="display: block;">
			<Print
				message="Para obtener la versión PDF presiona CTRL+P, selecciona guardar como PDF y disfruta de esta versión imprimible. 🖨️"
				buttonText="View in English"
			/>
			<Hero basics={cvEs.basics} labels={i18n.es.hero} />
			<About title={i18n.es.aboutTitle} summary={cvEs.basics.summary} />
			<Skills title={i18n.es.skillsTitle} skills={cvEs.skills} />
			<Education
				title={i18n.es.educationTitle}
				education={cvEs.education}
			/>
			<Languages
				title={i18n.es.languagesTitle}
				languages={cvEs.languages}
			/>
			<Experience title={i18n.es.experienceTitle} work={cvEs.work} />
			<Projects title={i18n.es.projectsTitle} projects={cvEs.projects} />
		</div>
		<div id="elemento-eng" style="display: none;">
			<Print
				message="To get the PDF version press CTRL+P, save as PDF and enjoy this printable version. 🖨️"
				buttonText="Ver en Español"
			/>
			<Hero basics={cvEn.basics} labels={i18n.en.hero} />
			<About title={i18n.en.aboutTitle} summary={cvEn.basics.summary} />
			<Skills title={i18n.en.skillsTitle} skills={cvEn.skills} />
			<Education
				title={i18n.en.educationTitle}
				education={cvEn.education}
			/>
			<Languages
				title={i18n.en.languagesTitle}
				languages={cvEn.languages}
			/>
			<Experience title={i18n.en.experienceTitle} work={cvEn.work} />
			<Projects title={i18n.en.projectsTitle} projects={cvEn.projects} />
		</div>
	</lang-button>
</main>

<style>
	main {
		padding: 4rem;
		margin: auto;
		width: 100%;
	}
	lang-button {
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		max-width: 700px;
		margin: 0 auto;
	}

	@media (width <= 700px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
